		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.310",
		"@anthropic-ai/sdk": "^0.93.0",
		"zod": "^4.4.3"
